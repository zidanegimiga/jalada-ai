# Settings for a live deployment. Nothing real goes in this file: it only says what each
# setting is. The real values live in the hosts' settings (Render for the API, Netlify for
# the web app) and in your password manager.
# The same settings for local work are in .env.example, in the same order.

# --- App ---
JALADA_ENVIRONMENT=production
JALADA_LOG_LEVEL=INFO
# The web app's public address, with https:// and no slash at the end.
JALADA_PUBLIC_URL=https://<web-app-address>
JALADA_COOKIE_SECURE=true
JALADA_SESSION_DAYS=30

# --- Database ---
# A Postgres connection string, starting postgresql+psycopg:// and ending ?sslmode=require
JALADA_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# --- Evidence storage ---
# Any S3-compatible store. For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
JALADA_STORAGE_ENDPOINT_URL=https://<storage-endpoint>
JALADA_STORAGE_BUCKET=jalada-evidence
# auto for Cloudflare R2.
JALADA_STORAGE_REGION=auto
# A key allowed to read and write objects in the bucket, and nothing else.
JALADA_STORAGE_ACCESS_KEY=<access-key-id>
JALADA_STORAGE_SECRET_KEY=<secret-access-key>
# Make one with: openssl rand -base64 32
# Keep a copy outside the host: without it, stored files cannot be read.
JALADA_EVIDENCE_KEYS=<base64-32-byte-key>

# --- Google sign-in ---
# Off until both are set. Redirect URI to register: <web-app-address>/v1/auth/google/callback
JALADA_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
JALADA_GOOGLE_CLIENT_SECRET=<client-secret>

# --- Telegram bot ---
# From @BotFather. Off until the token and username (without @) are both set.
JALADA_TELEGRAM_BOT_TOKEN=<bot-token>
JALADA_TELEGRAM_BOT_USERNAME=<bot-username>
# Long random text, given to Telegram when setting the webhook. Render can generate it.
JALADA_TELEGRAM_WEBHOOK_SECRET=<random-text>

# --- Language model ---
# none until a provider whose terms exclude training on what it is sent is set up.
JALADA_MODEL_PROVIDER=none
JALADA_MODEL_NAME=
JALADA_GEMINI_API_KEY=
JALADA_OLLAMA_URL=
# US dollars per million tokens, from the provider's price list.
JALADA_MODEL_INPUT_PRICE=0
JALADA_MODEL_OUTPUT_PRICE=0
# The app refuses to start with a model in production until this is true (decision 0012).
JALADA_MODEL_ALLOWED_FOR_REAL_DATA=false

# --- Pipeline limits, per piece of evidence ---
JALADA_PIPELINE_MAX_ATTEMPTS=3
JALADA_PIPELINE_MAX_TOKENS=8000
JALADA_PIPELINE_MAX_COST_USD=0.02

# --- Running on a host ---
# true on hosts with no separate release step, such as Render's free plan.
JALADA_MIGRATE_ON_START=true
# true on hosts with no background workers, such as Render's free plan (decision 0019).
JALADA_RUN_WORKER_IN_API=true

# --- Web app ---
# Set on the web host (Netlify), before the first build: the API's public address.
API_URL=https://<api-address>
