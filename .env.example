# Settings for running Jalada AI on your own machine.
# Copy to .env (cp .env.example .env). Never commit .env.
# The same settings for a live deployment are in .env.production.example.

# --- App ---
JALADA_ENVIRONMENT=development
JALADA_LOG_LEVEL=INFO
# The address people open in their browser. Google and Telegram send people back here.
JALADA_PUBLIC_URL=http://localhost:3000
# Local docker compose serves plain HTTP, where browsers drop Secure cookies.
JALADA_COOKIE_SECURE=false
JALADA_SESSION_DAYS=30

# --- Database ---
# Postgres from docker compose, reachable from your machine on port 5433.
JALADA_DATABASE_URL=postgresql+psycopg://jalada:jalada@localhost:5433/jalada

# --- Evidence storage ---
# SeaweedFS from docker compose, on port 8333.
JALADA_STORAGE_ENDPOINT_URL=http://localhost:8333
JALADA_STORAGE_BUCKET=jalada-evidence
JALADA_STORAGE_REGION=us-east-1
JALADA_STORAGE_ACCESS_KEY=jalada
JALADA_STORAGE_SECRET_KEY=jalada-local-secret
# Encrypts every stored file. This one is for local, invented data only.
# Several keys can be given, comma separated: the first encrypts, the rest still decrypt.
JALADA_EVIDENCE_KEYS=bG9jYWwtZGV2ZWxvcG1lbnQta2V5LTMyLWJ5dGVzISE=

# --- Google sign-in ---
# Off until both are set. Redirect URI to register: http://localhost:3000/v1/auth/google/callback
JALADA_GOOGLE_CLIENT_ID=
JALADA_GOOGLE_CLIENT_SECRET=

# --- Telegram bot ---
# From @BotFather. Off until the token and username (without @) are both set.
JALADA_TELEGRAM_BOT_TOKEN=
JALADA_TELEGRAM_BOT_USERNAME=
# Only used when Telegram calls a deployed app. Locally the bot polls instead.
JALADA_TELEGRAM_WEBHOOK_SECRET=

# --- Language model ---
# For evidence the rules and Tesseract cannot read: none, gemini or ollama.
# Free tiers and local models are for invented data only (decision 0012).
JALADA_MODEL_PROVIDER=none
JALADA_MODEL_NAME=
JALADA_GEMINI_API_KEY=
JALADA_OLLAMA_URL=http://localhost:11434
# US dollars per million tokens, recorded on each run. Zero on free tiers and Ollama.
JALADA_MODEL_INPUT_PRICE=0
JALADA_MODEL_OUTPUT_PRICE=0
# Only true for a provider whose terms exclude training on what it is sent.
JALADA_MODEL_ALLOWED_FOR_REAL_DATA=false

# --- Pipeline limits, per piece of evidence ---
JALADA_PIPELINE_MAX_ATTEMPTS=3
JALADA_PIPELINE_MAX_TOKENS=8000
JALADA_PIPELINE_MAX_COST_USD=0.02

# --- Running on a host ---
# Run migrations and check the bucket when the API starts. Locally, docker compose does
# this in its own migrate step instead.
JALADA_MIGRATE_ON_START=false
# Run the job loop on a thread inside the API (decision 0019). Locally the worker runs it.
JALADA_RUN_WORKER_IN_API=false
# The version /health reports. Hosts set it; Render's RENDER_GIT_COMMIT is used when present.
JALADA_VERSION=
# Sends errors to Sentry. Usually left empty locally.
JALADA_SENTRY_DSN=

# --- Web app ---
# Where the Next.js app sends /v1 requests. The API from docker compose or uv run.
API_URL=http://localhost:8000

# --- Local only ---
# Password for the Postgres container in docker compose.
POSTGRES_PASSWORD=jalada
