{
  "name": "jalada-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Jalada AI for the desktop: works offline and syncs when back online (decision 0029).",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "e2e": "playwright test",
    "postinstall": "electron-rebuild --force --only better-sqlite3-multiple-ciphers"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.2.0"
  }
}
